APP_NAME=社区旧物互换智能体平台
API_PREFIX=/api/v1
DEBUG=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=swap
DB_CHARSET=utf8mb4
DB_POOL_MIN_CACHED=1
DB_POOL_MAX_CACHED=5
DB_POOL_MAX_CONNECTIONS=20
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
# 邮件服务：EMAIL_PROVIDER=smtp 真实发送；填 mock 则只在后端控制台输出验证码
# QQ 邮箱的 SMTP_PASSWORD 需填「授权码」而非邮箱登录密码
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_email@qq.com

# 短信服务：mock=控制台输出（开发用）；aliyun 需配置下面四项
# AccessKey：阿里云控制台 - AccessKey 管理；签名/模板：短信服务控制台（需审核通过）
SMS_PROVIDER=smtp
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 用户上传图片存储目录（相对运行目录）
UPLOAD_DIR=uploads
DB_CONNECT_TIMEOUT=5
# 管理端配置
ADMIN_TOKEN_EXPIRE_MINUTES=1440
AI_MONITOR_ENABLED=true
# 验证码配置
CODE_EXPIRE_MINUTES=5
CODE_RESEND_SECONDS=60
# 大模型API配置（阿里云百炼 DashScope OpenAI 兼容接口）
# 智能体对话/LLM情感分析用 LLM_API_MODEL；物体识别用 LLM_VL_MODEL（多模态）
# 助老模式语音合成用 LLM_TTS_MODEL（qwen3-tts-flash；LLM_TTS_VOICE 为系统音色；合成失败时前端自动降级浏览器播报）
# LLM_API_KEY 留空时自动降级为本地演示模式
LLM_API_KEY=sk-your-dashscope-api-key
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_MODEL=deepseek-v4-pro-0813
LLM_VL_MODEL=qwen-vl-plus
LLM_TTS_MODEL=qwen3-tts-flash
LLM_TTS_VOICE=Cherry
# DashScope 原生接口（文生图）
IMAGE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
TASK_API_URL=https://dashscope.aliyuncs.com/api/v1/tasks/{task_id}

