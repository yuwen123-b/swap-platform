APP_NAME=社区旧物互换智能体平台
API_PREFIX=/api/v1
DEBUG=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=swap
DB_CHARSET=utf8mb4
DB_POOL_MIN_CACHED=1
DB_POOL_MAX_CACHED=5
DB_POOL_MAX_CONNECTIONS=20
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# 生产/云端部署：把前端正式域名（如 EdgeOne）显式加入白名单；DEBUG=true 时此行被通配规则覆盖
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://swap-platform.edgeone.cool
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
# 邮件服务：EMAIL_PROVIDER=smtp 真实发送；填 mock 则只在后端控制台输出验证码
# QQ 邮箱的 SMTP_PASSWORD 需填「授权码」而非邮箱登录密码
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_email@qq.com

# 短信服务：mock=控制台输出（开发用）；aliyun 需配置下面四项
# AccessKey：阿里云控制台 - AccessKey 管理；签名/模板：短信服务控制台（需审核通过）
SMS_PROVIDER=smtp
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 用户上传图片存储目录（相对运行目录）
UPLOAD_DIR=uploads
DB_CONNECT_TIMEOUT=5
# 管理端配置
ADMIN_TOKEN_EXPIRE_MINUTES=1440
AI_MONITOR_ENABLED=true
# 验证码配置
CODE_EXPIRE_MINUTES=5
CODE_RESEND_SECONDS=60
# 大模型API配置（阿里云百炼 DashScope）
# 所有模型密钥、URL、模型名统一在此配置，代码通过 config.py settings 读取
# DASHSCOPE_API_KEY 留空时自动降级为本地演示模式

# ===== 文本/对话/推理 =====
DASHSCOPE_API_KEY=sk-your-key-here
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_MODEL=deepseek-v4-pro-0813

# ===== 多模态/图像识别 =====
LLM_VL_MODEL=qwen3-omni-flash

# ===== 图像编辑（360° 视角外推）=====
# 注意：必须是 image2image 接口，不是 text2image
IMAGE_EDIT_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis
LLM_IMAGE_EDIT_MODEL=wanx2.1-imageedit

# ===== 文生图（降级方案补齐缺失视角）=====
IMAGE_GEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
LLM_IMAGE_GEN_MODEL=wanx2.1-t2i-turbo

# ===== 语音合成（助老模式 TTS）=====
# qwen3-tts-flash 已验证可用（同步 HTTP）；cosyvoice-v1 需 WebSocket 不支持此端点
TTS_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
LLM_TTS_MODEL=qwen3-tts-flash
LLM_TTS_VOICE=Cherry

# ===== 语音识别（助老模式 ASR）=====
# ★ 排查手册（2026-10-20 实测）★
# 主链路 qwen3-asr-flash 走多模态接口，**base64 直传本地文件**，不依赖 PUBLIC_BASE_URL。
# 旧配置的 paraformer 文件转写有两点坑：
#   ① LLM_ASR_MODEL 填 paraformer-realtime-v2 是错的——它是实时流式模型，文件转写不接受；
#   ② 本账号 paraformer-v2 文件转写返回 SERVER_ERROR（模型未开通），换 WAV 也一样，
#      表现为任务秒级 FAILED、code=SERVER_ERROR、results 为空。
# 因此 paraformer 只作兜底（需公网 URL），默认主链路是 qwen3-asr-flash。
ASR_MULTIMODAL_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
LLM_ASR_MODEL=qwen3-asr-flash
ASR_API_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
LLM_ASR_MODEL_PARA=paraformer-v2

# ===== 异步任务轮询地址（{task_id} 为占位符）=====
TASK_API_URL=https://dashscope.aliyuncs.com/api/v1/tasks/{task_id}

# ===== 文本向量模型（Chroma 向量库预留）=====
LLM_EMBEDDING_MODEL=text-embedding-v4

# ===== 公网访问地址 =====
# 图像编辑/语音识别需向 DashScope 提供公网可达的文件 URL
# 本地开发可用 ngrok 隧道；留空则相关能力自动降级
PUBLIC_BASE_URL=https://silica-pushover-rudder.ngrok-free.dev

# ===== 各能力独立的 API Key（共享主密钥时与 DASHSCOPE_API_KEY 相同）=====
VL_API_URL=
EMBEDDING_API_URL=

# ========== 魔搭社区（ModelScope）免费API ==========
# 每日 2000 次免费调用；Key 格式 ms-xxxxx
# ⚠️ 实测其推理网关只有文本模型（/v1/models 共 37 个），音频端点全部 404：
#    /v1/audio/transcriptions、/v1/audio/speech 均返回 "404 page not found"。
#    所以语音能力默认走百炼（ASR_PROVIDER/TTS_PROVIDER=dashscope），此处仅供实验。
MODELSCOPE_API_KEY=
MODELSCOPE_API_URL=https://api-inference.modelscope.cn/v1

# 语音识别（ASR_PROVIDER=modelscope 时生效；当前网关不支持，会立即失败并降级百炼）
ASR_PROVIDER=dashscope
ASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512

# 语音合成（TTS_PROVIDER=modelscope 时生效；同上，默认走百炼 qwen3-tts-flash）
TTS_PROVIDER=dashscope
TTS_MODEL=iic/CosyVoice2-0.5B

# 图像编辑（IMAGE_PROVIDER=modelscope 时生效）
IMAGE_PROVIDER=modelscope
IMAGE_MODEL=Qwen/Qwen-Image-Edit-2511

# ========== MCP 服务（图表生成） ==========
# mcp-server-chart 的 SSE URL，留空时 Agent 不注册图表工具
MCP_CHART_SSE_URL=https://mcp.api-inference.modelscope.net/041729df95fa42/sse
# 高德地图 MCP（魔搭部署）
MCP_AMAP_URL=https://mcp.api-inference.modelscope.net/e552a9369f0945/mcp

# 高德地图 Web 服务 Key（地址 → 坐标「地理编码」，个人中心位置管理页「手动输入地址」使用）
# 留空时 POST /api/v1/user/location/search-address 返回 501，其余功能不受影响
AMAP_WEB_KEY=

# 智能体助手对外名称（改名只需改此行）
AGENT_NAME=邻里通
AMAP_WEB_KEY=5639da3bef53ee7062a903aa08f48c80
# ========== 商家端闭环（用户赚积分 → 兑换商家服务 → 商家核销 → 平台结算） ==========
# 总开关：false 时 /api/v1/merchant 下所有用户/商家侧接口一律 403（管理端不受影响）
MERCHANT_ENABLED=true
# 佣金比例默认值（%）：仅在新建商家时作为初始值写入 merchant.commission_rate，
# 之后一律以 merchant 表那一行为准，管理员可对单店单独调整
MERCHANT_COMMISSION_RATE=5.00
# 积分 → 现金汇率（元/积分）：100 积分 = 1 元
# 结算佣金 = points_total × MERCHANT_POINTS_TO_YUAN × (commission_rate / 100)
MERCHANT_POINTS_TO_YUAN=0.01
# 核销码有效期（天）：超期未核销即置为已过期并原额退还积分
REDEMPTION_CODE_EXPIRE_DAYS=30
# 过期扫描循环间隔（秒）：默认 3600（每小时一次）
REDEMPTION_EXPIRE_INTERVAL_SECONDS=3600

# ========== 3D 物品模型生成（默认腾讯混元 3D 极速版；Tripo 为回退分支） ==========
# 总开关：默认 false，仅演示时置 true（每次生成都会花钱）。
# ⚠️ 注意取值必须是 true/false/1/0/yes/no，写成 "flase" 这类拼写错误会让 Settings
#    加载直接抛 ValidationError，表现为「后端完全起不来」（2026-10-16 已实际踩过一次）。
MODEL_3D_ENABLED=false
# 服务商：hunyuan（腾讯混元 3D 极速版，默认） | tripo（百炼 Tripo，回退）
MODEL_3D_PROVIDER=hunyuan

# ---- Provider: hunyuan（腾讯混元 3D 极速版，走 TokenHub 网关）----
# ★★ 排查手册（本段是 2026-10-16 真实接入后沉淀，照着查能省 30 分钟）★★
# 1. 鉴权：TokenHub 用的是「控制台 API Key 管理里创建的 API Key（sk- 开头）+ Bearer」，
#    **不是** SecretId/SecretKey 的 TC3 签名。因此：不需要 tencentcloud-sdk-python，
#    也没有 region 概念（ap-guangzhou 之类的参数对本网关无效），requests 直连即可。
# 2. 域名以官方文档为准：tokenhub.tencentmaas.com（实测可达）。
#    控制台截图里可能显示 tokenhub.tencentsaas.com，实测本机 DNS 解析失败，勿用。
# 3. 端点：POST {TOKENHUB_API_URL}/v1/api/3d/submit 与 /v1/api/3d/query。
# 4. 提交三选一且互斥：prompt（文生）/ image_base64（≤6MB）/ image_url（≤8MB）。
#    本实现固定走 image_base64 —— 好处是 3D 链路不再依赖 PUBLIC_BASE_URL 公网可达。
# 5. 必须显式传 result_format="glb"：默认返回 obj 格式组，前端 ModelViewer 只吃 GLB。
# 6. 输出是 COS 签名 URL（24 小时有效），拿到后必须立即下载落盘（本服务已自动处理）。
# 7. 状态：queued / in_progress / completed / failed；任务 id 有效期 24 小时。
# 8. 并发只有 1（上一个任务跑完才能提交下一个）——同时在跑两个物品时后一个会报并发错误。
# 9. 计费：TokenHub 积分制，1 积分 = 0.12 元；Express 15~25 积分/次（约 1.8~3 元），
#    **失败不计费**。新人免费体验包 3D 额度 100 积分（≈4~6 次），
#    领取入口：控制台 → 模型广场 → 「新用户福利免费体验」（活动截至 2026-12-31）。
# 10. 常见报错 → 本服务已归一化成中文写入 item.model_error：
#     FailedOperation.ConcurrencyLimit → 「同时只能处理 1 个任务」
#     欠费/额度不足 → 提示充值或领取免费包；401 → 提示检查 TOKENHUB_API_KEY。
TOKENHUB_API_KEY=
TOKENHUB_API_URL=https://tokenhub.tencentmaas.com
# hy-3d-express：极速版，官方口径 ≤1 分 30 秒出结果
HUNYUAN_3D_MODEL=hy-3d-express
# PBR 材质（metallic/roughness/normal 贴图）：false 省 10 积分/次；true 观感更真实
HUNYUAN_3D_PBR=false

# ---- Provider: tripo（百炼 Tripo，回退分支：MODEL_3D_PROVIDER=tripo 时生效）----
# ★★ 排查手册（本坑已踩两次：2026-10-14 / 2026-10-16，每次排查 30+ 分钟）★★
# 任务 FAILED 且 message 含 "The product is not activated" = 百炼账号未开通 Tripo（或开通未生效）。
# 与代码/网络/Key 无关：同一把 Key 调 qwen 正常、提交 3D 也能拿到 task_id，只有任务终态是 FAILED。
# 解决：在阿里云百炼控制台开通 Tripo（每个模型单独开通，H3.1 与 P1.0 是两个开关），开通后约 10 分钟生效。
# 只实测通过的是 H3.1；P1.0 文件小（≤2 万面 vs 144 万面）但从未真实跑通，切换后需人工确认一次产物。
# 其余前置：DASHSCOPE_API_KEY 必填；PUBLIC_BASE_URL 必须公网可达（Tripo 只吃公网 URL，不支持 base64）。
MODEL_3D_MODEL=Tripo/Tripo-H3.1
MODEL_3D_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/video-generation/3d-generation
MODEL_3D_TEXTURE_QUALITY=standard
